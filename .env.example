# OpenAI API Key for embeddings (if using EmbeddingProvider.OPENAI)
OPENAI_API_KEY=your-openai-api-key-here

# PostgreSQL connection string for pgvector integration tests
# Required to run pgvector integration tests. If not set, those tests are skipped.
TEST_POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/ragstack_test

# -----------------------------------------------------------------------------
# Optional: Connection strings for vector stores (if used in your app layer)
# -----------------------------------------------------------------------------
# PGVECTOR_CONNECTION_STRING=postgresql://user:password@localhost:5432/ragstack
# QDRANT_CONNECTION_STRING=http://localhost:6333
# CHROMA_CONNECTION_STRING=./chroma_data
